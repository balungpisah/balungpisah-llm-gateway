# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agents
POSTGRES_PORT=5432

# ClickHouse (for TensorZero observability)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_PORT=8123

# TensorZero
TENSORZERO_PORT=3000
TENSORZERO_UI_PORT=4000

# Note: LLM API keys are provided dynamically by ADK consumers at request time.
# No static API keys are needed in this configuration.
